<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Script file="CastBar.lua"/>

    <StatusBar name="CleanBarsCastingBarTemplate" hidden="true" virtual="true">
        <Size x="250" y="24"/>

        <Backdrop bgFile="Interface\Buttons\WHITE8X8" edgeFile="Interface\Buttons\WHITE8X8" tile="false">
            <EdgeSize val="1"/>
            <BackgroundInsets left="1" right="1" top="1" bottom="1"/>
        </Backdrop>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentIcon" hidden="true"/>
            </Layer>
            
            <Layer level="ARTWORK">
                <FontString name="$parentText" font="GameFontHighlight" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset x="4" y="0"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentTime" font="GameFontHighlight" hidden="true" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset x="-4" y="0"/>
                        </Anchor>
                    </Anchors>
                </FontString>
                
                <Texture name="$parentBorder" hidden="true"/>
                <Texture name="$parentBorderShield" hidden="true"/>
                <Texture name="$parentShield" hidden="true"/>
            </Layer>

            <Layer level="OVERLAY">
                <Texture name="$parentSpark" file="Interface\CastingBar\UI-CastingBar-Spark" alphaMode="ADD">
                    <Size x="32" y="32"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
                
                <Texture name="$parentFlash" file="Interface\Buttons\WHITE8X8" alphaMode="ADD" hidden="true">
                    <Size x="250" y="24"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.5"/>
                </Texture>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                CastingBarFrame_OnLoad(self, 'player', true, false)
            </OnLoad>
        </Scripts>

        <BarTexture file="Interface\Buttons\WHITE8X8"/>
        <BarColor r="1.0" g="0.7" b="0.0"/>
    </StatusBar>
</Ui>